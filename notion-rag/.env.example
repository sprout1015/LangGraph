# ===========================================
# Notion RAG System Environment Variables
# ===========================================
# Copy this file to .env and fill in your API keys
# cp .env.example .env

# ===========================================
# Required: LLM API (Answer Generation)
# ===========================================
# Anthropic Claude API - Required for LLM response generation
# Get your key at: https://console.anthropic.com
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# LLM Model (Claude)
LLM_MODEL=claude-sonnet-4-20250514

# ===========================================
# Required: Notion API
# ===========================================
# 1. Create Integration at: https://www.notion.so/my-integrations
# 2. Share target page/database with the Integration
NOTION_API_KEY=your-notion-api-key-here

# Notion Database ID (Optional - can be specified in code)
# URL format: notion.so/{workspace}/{database_id}?v=...
# Convert 32-char ID to: xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
NOTION_DATABASE_ID=your-database-id-here

# ===========================================
# Optional: Embedding API
# ===========================================
# OpenAI API - Optional for embeddings
# If not provided, HuggingFace free model will be used
# Get your key at: https://platform.openai.com
OPENAI_API_KEY=your-openai-api-key-here

# Embedding Model
# OpenAI: text-embedding-3-small, text-embedding-ada-002
# HuggingFace (free): sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_MODEL=text-embedding-3-small

# ===========================================
# Vector DB Settings
# ===========================================

# Vector DB Type: "chroma" or "postgres"
VECTOR_DB_TYPE=postgres

# ChromaDB Settings (if VECTOR_DB_TYPE=chroma)
CHROMA_PERSIST_DIR=./data/chroma

# PostgreSQL + pgvector Settings (if VECTOR_DB_TYPE=postgres)
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-postgres-password
POSTGRES_DB=notion_rag
POSTGRES_COLLECTION=notion_documents
