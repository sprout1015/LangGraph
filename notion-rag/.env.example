# ===========================================
# Notion RAG System Environment Variables
# ===========================================
# 이 파일을 .env로 복사하고 실제 API 키를 입력하세요
# cp .env.example .env

# OpenAI API
OPENAI_API_KEY=your-openai-api-key-here

# Anthropic API (선택사항)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Notion API
# 1. https://www.notion.so/my-integrations 에서 Integration 생성
# 2. 연동할 페이지/데이터베이스에 Integration 공유 권한 부여
NOTION_API_KEY=your-notion-integration-token-here

# 노션 데이터베이스 ID (선택사항 - 코드에서도 지정 가능)
NOTION_DATABASE_ID=your-database-id-here

# ===========================================
# 모델 설정
# ===========================================

# 임베딩 모델 (OpenAI)
EMBEDDING_MODEL=text-embedding-3-small

# LLM 모델
LLM_MODEL=gpt-4o-mini

# ===========================================
# 벡터 DB 설정
# ===========================================

# ChromaDB 저장 경로
CHROMA_PERSIST_DIR=./data/chroma
